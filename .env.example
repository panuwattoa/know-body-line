# ---------- KnowBody environment ----------
# Copy to .env.local for local dev, and set the same in Vercel Project Settings.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
COACH_NAME=โค้ช            # persona name shown in chat (rebrandable)
NEXT_PUBLIC_LINE_ADD_FRIEND_URL=  # e.g. https://lin.ee/xxxxxx (LINE OA add-friend link)

# LINE Messaging API (Provider > Messaging API channel)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Login channel (used by LIFF ID-token verification)
LINE_LOGIN_CHANNEL_ID=

# LIFF app ids (create one LIFF per view, endpoint = <APP_URL>/liff/<view>)
NEXT_PUBLIC_LIFF_ID_ONBOARDING=
NEXT_PUBLIC_LIFF_ID_HISTORY=
NEXT_PUBLIC_LIFF_ID_REPORT=
NEXT_PUBLIC_LIFF_ID_PROFILE=

# Google AI Studio (Gemini)
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cron protection (Vercel Cron sends this as Authorization: Bearer)
CRON_SECRET=
